{
  "_template": "frag_ab 社区版协议: kfragd=0 + proactiveness=50 + 设备端碎片循环 + proact保持器",
  "config": {
    "rounds": 1,
    "sysctl_nodes": [
      {
        "param": "kfragd_enabled",
        "path": "/proc/sys/vm/kfragd_enabled",
        "expected": "0"
      },
      {
        "param": "kfragd_interval_ms",
        "path": "/proc/sys/vm/kfragd_interval_ms",
        "expected": "100"
      },
      {
        "param": "kfragd_frag_high",
        "path": "/proc/sys/vm/kfragd_frag_high",
        "expected": "70"
      },
      {
        "param": "kfragd_frag_low",
        "path": "/proc/sys/vm/kfragd_frag_low",
        "expected": "30"
      },
      {
        "param": "kfragd_force_reclaim",
        "path": "/proc/sys/vm/kfragd_force_reclaim",
        "expected": "0"
      },
      {
        "param": "mthp_16k",
        "path": "/sys/kernel/mm/transparent_hugepage/hugepages-16kB/enabled",
        "expected": "[always]"
      },
      {
        "param": "compaction_proactiveness",
        "path": "/proc/sys/vm/compaction_proactiveness",
        "expected": "50"
      }
    ],
    "backend": {
      "name": "frag_ab",
      "config": {
        "source": "fragmem",
        "duration_s": 240,
        "fragmem_alloc_mb": 4000,
        "fragmem_cycle_s": 15,
        "fragmem_loop_on_device": true,
        "proact_keeper": 50
      }
    },
    "precondition": {
      "mode": "once",
      "restart": false
    },
    "exp_ctx": {
      "exp_name": "frag_ab_fragmem_16k_4min_loop_proact50",
      "domain": "pixel",
      "platform": "pixel"
    },
    "boot_params": [
      {
        "param": "fs_disable_large_folio",
        "path": "/sys/module/kernel/parameters/fs_disable_large_folio",
        "expected": "0"
      },
      {
        "param": "thp_anon",
        "path": "/proc/cmdline",
        "expected": "16K:always",
        "contains": true
      }
    ]
  },
  "sample_config": {
    "cycle_sample": {
      "interval_s": 20,
      "probes": [
        {
          "name": "counters",
          "enabled": true,
          "interval_s": 60
        },
        {
          "name": "vmstat",
          "enabled": true
        },
        {
          "name": "buddyinfo",
          "enabled": true,
          "interval_s": 20
        },
        {
          "name": "pagetypeinfo",
          "enabled": true,
          "interval_s": 10
        }
      ]
    },
    "tasktime": {
      "procs": [
        "kswapd0",
        "kcompactd0",
        "kfragd0"
      ],
      "interval_s": 2,
      "strict": false
    },
    "trace": {
      "captures": [
        {
          "name": "main",
          "events": [
            "vmscan:mm_vmscan_direct_reclaim_begin",
            "vmscan:mm_vmscan_direct_reclaim_end",
            "vmscan:mm_vmscan_memcg_reclaim_begin",
            "vmscan:mm_vmscan_memcg_reclaim_end",
            "vmscan:mm_vmscan_reclaim_pages"
          ],
          "buffer_kb": 16384
        }
      ]
    }
  }
}
