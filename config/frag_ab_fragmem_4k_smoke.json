{
  "_template": "frag_ab: fragmem 持续压力, kfragd 100ms 70/30, 4K",
  "config": {
    "rounds": 1,
    "sysctl_nodes": [
      {
        "param": "kfragd_enabled",
        "path": "/proc/sys/vm/kfragd_enabled",
        "expected": "1"
      },
      {
        "param": "kfragd_interval_ms",
        "path": "/proc/sys/vm/kfragd_interval_ms",
        "expected": "100"
      },
      {
        "param": "kfragd_frag_high",
        "path": "/proc/sys/vm/kfragd_frag_high",
        "expected": "70"
      },
      {
        "param": "kfragd_frag_low",
        "path": "/proc/sys/vm/kfragd_frag_low",
        "expected": "30"
      },
      {
        "param": "kfragd_force_reclaim",
        "path": "/proc/sys/vm/kfragd_force_reclaim",
        "expected": "0"
      },
      {
        "param": "mthp_16k",
        "path": "/sys/kernel/mm/transparent_hugepage/hugepages-16kB/enabled",
        "expected": "[never]"
      }
    ],
    "backend": {
      "name": "frag_ab",
      "config": {
        "source": "fragmem",
        "duration_s": 30,
        "fragmem_alloc_mb": 4000,
        "fragmem_cycle_s": 15
      }
    },
    "precondition": {
      "mode": "once",
      "restart": false
    },
    "exp_ctx": {
      "exp_name": "frag_ab_fragmem_4k_smoke",
      "domain": "pixel",
      "platform": "pixel"
    }
  },
  "sample_config": {
    "cycle_sample": {
      "interval_s": 20,
      "probes": [
        {
          "name": "counters",
          "enabled": true,
          "interval_s": 60
        },
        {
          "name": "vmstat",
          "enabled": true
        },
        {
          "name": "buddyinfo",
          "enabled": true,
          "interval_s": 20
        },
        {
          "name": "pagetypeinfo",
          "enabled": true,
          "interval_s": 10
        }
      ]
    },
    "tasktime": {
      "procs": [
        "kswapd0",
        "kcompactd0",
        "kfragd0"
      ],
      "interval_s": 2,
      "strict": false
    },
    "trace": {
      "captures": [
        {
          "name": "main",
          "events": [
            "vmscan:mm_vmscan_direct_reclaim_begin",
            "vmscan:mm_vmscan_direct_reclaim_end",
            "vmscan:mm_vmscan_memcg_reclaim_begin",
            "vmscan:mm_vmscan_memcg_reclaim_end",
            "vmscan:mm_vmscan_reclaim_pages"
          ],
          "buffer_kb": 16384
        }
      ]
    }
  }
}
